# Buildkite API Token (optional, needed for some operations)
BUILDKITE_API_TOKEN=

# Slack Webhook URL for notifications (optional)
SLACK_WEBHOOK_URL=

# Database URL (default is SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/ci-bot.db

# Claude Code via Vertex AI
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=us-east5
ANTHROPIC_VERTEX_PROJECT_ID=itpc-gcp-ai-eng-claude
